<section class="admin-orders-section py-4 bg-light min-vh-100">
    <div class="container-fluid px-lg-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Customer Orders</h2>
                <p class="text-muted small mb-0">Manage customer fulfillment and live status updates.</p>
            </div>
            <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Back to Dashboard</a>
        </div>

        <!-- Status Filter Tabs -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-sm rounded-pill px-3 py-1 fw-medium status-filter-btn active" data-filter="all" onclick="filterOrdersByStatus('all', this)">
                All <span class="badge bg-dark rounded-pill ms-1" id="count-all">{{orders.length}}</span>
            </button>
            <button class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 fw-medium status-filter-btn" data-filter="placed" onclick="filterOrdersByStatus('placed', this)">
                🆕 Placed <span class="badge bg-info rounded-pill ms-1" id="count-placed">0</span>
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-medium status-filter-btn" data-filter="shipped" onclick="filterOrdersByStatus('shipped', this)">
                📦 Shipped <span class="badge bg-primary rounded-pill ms-1" id="count-shipped">0</span>
            </button>
            <button class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-medium status-filter-btn" data-filter="delivered" onclick="filterOrdersByStatus('delivered', this)">
                ✅ Delivered <span class="badge bg-success rounded-pill ms-1" id="count-delivered">0</span>
            </button>
            <button class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 fw-medium status-filter-btn" data-filter="pending" onclick="filterOrdersByStatus('pending', this)">
                ⏳ Pending <span class="badge bg-warning text-dark rounded-pill ms-1" id="count-pending">0</span>
            </button>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-medium status-filter-btn" data-filter="canceled" onclick="filterOrdersByStatus('canceled', this)">
                ❌ Canceled <span class="badge bg-danger rounded-pill ms-1" id="count-canceled">0</span>
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0" id="ordersCardTitle">All Orders ({{orders.length}})</h5>
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 fs-8" id="activeFilterBadge">All Statuses</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="ordersTable">
                    <thead class="table-light text-muted small text-uppercase letter-spacing-1">
                        <tr>
                            <th class="ps-4 py-3">Date</th>
                            <th class="py-3">Shipping Address</th>
                            <th class="py-3">Contact</th>
                            <th class="py-3">Amount</th>
                            <th class="py-3">Payment</th>
                            <th class="py-3" style="min-width: 160px;">Status</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if orders.length}}
                            {{#each orders}}
                            <tr class="order-row" data-status="{{this.status}}">
                                <td class="ps-4 text-nowrap">
                                    <span class="fw-medium text-dark small">{{this.date}}</span>
                                    {{#unless this.adminViewed}}
                                        <span class="badge bg-danger rounded-pill ms-1 px-1 py-0" style="font-size: 0.6rem;">NEW</span>
                                    {{/unless}}
                                </td>

                                <td>
                                    <div class="text-dark small fw-medium">{{this.deliveryDetails.address}}</div>
                                    <div class="text-muted fs-8">PIN: {{this.deliveryDetails.pincode}}</div>
                                </td>

                                <td>
                                    <span class="small text-muted">{{this.deliveryDetails.mobile}}</span>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark fs-6">₹{{this.totalAmount}}</span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 fs-8">
                                        {{this.paymentMethod}}
                                    </span>
                                </td>

                                <td>
                                    <select class="form-select form-select-sm rounded-pill fw-medium status-select
                                        {{#if (eq this.status 'delivered')}}border-success text-success bg-success-subtle{{/if}}
                                        {{#if (eq this.status 'shipped')}}border-primary text-primary bg-primary-subtle{{/if}}
                                        {{#if (eq this.status 'placed')}}border-info text-info bg-info-subtle{{/if}}
                                        {{#if (eq this.status 'pending')}}border-warning text-warning bg-warning-subtle{{/if}}
                                        {{#if (eq this.status 'canceled')}}border-danger text-danger bg-danger-subtle{{/if}}"
                                        onchange="statusChange(this.value, '{{this._id}}', this)"
                                        style="max-width: 150px; cursor: pointer;">
                                        <option value="placed" {{#if (eq this.status 'placed')}}selected{{/if}}>🆕 Placed</option>
                                        <option value="shipped" {{#if (eq this.status 'shipped')}}selected{{/if}}>📦 Shipped</option>
                                        <option value="delivered" {{#if (eq this.status 'delivered')}}selected{{/if}}>✅ Delivered</option>
                                        <option value="pending" {{#if (eq this.status 'pending')}}selected{{/if}}>⏳ Pending</option>
                                        <option value="canceled" {{#if (eq this.status 'canceled')}}selected{{/if}}>❌ Canceled</option>
                                    </select>
                                </td>

                                <td class="text-end pe-4 text-nowrap">
                                    <a href="/admin/view-order-products/{{this._id}}" class="btn btn-sm btn-dark rounded-pill px-3 py-1">
                                        Products
                                    </a>
                                    <a href="/admin/view-profile/{{this.userId}}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 ms-1">
                                        Customer
                                    </a>
                                </td>
                            </tr>
                            {{/each}}
                            <tr id="noFilterMatchRow" style="display: none;">
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                    </div>
                                    <h6 class="fw-bold mb-1" id="noFilterMatchText">No Orders in this Status</h6>
                                    <button class="btn btn-sm btn-outline-dark rounded-pill px-3 mt-2" onclick="filterOrdersByStatus('all')">View All Orders</button>
                                </td>
                            </tr>
                        {{else}}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                        </svg>
                                    </div>
                                    <h5 class="fw-bold mb-1">No Orders Recorded Yet</h5>
                                    <p class="text-muted small mb-0">Customer orders will appear here automatically when checked out.</p>
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<style>
    .status-select {
        transition: all 0.3s ease;
        border-width: 2px;
        font-size: 0.82rem;
        padding: 0.35rem 2rem 0.35rem 0.75rem;
    }
    .status-select:focus {
        box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.1);
    }
    .status-filter-btn {
        transition: all 0.25s ease;
    }
    .status-filter-btn.active {
        background: #111 !important;
        color: #fff !important;
        border-color: #111 !important;
    }
    .order-row.fade-out {
        opacity: 0.4;
        transition: opacity 0.3s ease;
    }
</style>

<script>
    // Status change via AJAX using a simple select dropdown (no swipe issues)
    function statusChange(status, orderId, selectEl) {
        // Add loading state
        selectEl.disabled = true;
        selectEl.classList.add('opacity-50');

        $.ajax({
            url: '/admin/status-change',
            method: 'post',
            data: {
                status: status,
                orderId: orderId
            },
            success: (response) => {
                if (response.status) {
                    // Update the select styling based on new status
                    selectEl.className = 'form-select form-select-sm rounded-pill fw-medium status-select';
                    
                    const styleMap = {
                        'delivered': 'border-success text-success bg-success-subtle',
                        'shipped': 'border-primary text-primary bg-primary-subtle',
                        'placed': 'border-info text-info bg-info-subtle',
                        'pending': 'border-warning text-warning bg-warning-subtle',
                        'canceled': 'border-danger text-danger bg-danger-subtle'
                    };
                    selectEl.classList.add(...(styleMap[status] || '').split(' '));
                    
                    // Update the row's data-status
                    selectEl.closest('tr').setAttribute('data-status', status);
                    
                    // Update counts
                    updateFilterCounts();
                    
                    // Show toast notification
                    showStatusToast('Status updated to ' + status.charAt(0).toUpperCase() + status.slice(1));
                }
                selectEl.disabled = false;
                selectEl.classList.remove('opacity-50');
            },
            error: () => {
                alert('Failed to update status. Please try again.');
                selectEl.disabled = false;
                selectEl.classList.remove('opacity-50');
                location.reload();
            }
        });
    }

    // Status labels dictionary
    const statusLabels = {
        'all': 'All Orders',
        'placed': 'New / Placed Orders',
        'shipped': 'Shipped Orders',
        'delivered': 'Delivered Orders',
        'pending': 'Pending Orders',
        'canceled': 'Cancelled Orders'
    };

    // Filter orders by status tab
    function filterOrdersByStatus(status, btnEl) {
        if (!btnEl) {
            btnEl = document.querySelector(`.status-filter-btn[data-filter="${status}"]`);
        }

        // Update active tab button
        document.querySelectorAll('.status-filter-btn').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');
        
        const rows = document.querySelectorAll('.order-row');
        let visibleCount = 0;

        rows.forEach(row => {
            if (status === 'all' || row.getAttribute('data-status') === status) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Show/hide empty state
        const noMatchRow = document.getElementById('noFilterMatchRow');
        const noMatchText = document.getElementById('noFilterMatchText');
        if (noMatchRow) {
            if (visibleCount === 0 && rows.length > 0) {
                noMatchRow.style.display = '';
                if (noMatchText) noMatchText.textContent = `No ${statusLabels[status] || status} Found`;
            } else {
                noMatchRow.style.display = 'none';
            }
        }

        // Update card title and active filter badge
        const cardTitle = document.getElementById('ordersCardTitle');
        const filterBadge = document.getElementById('activeFilterBadge');
        if (cardTitle) {
            cardTitle.textContent = `${statusLabels[status] || 'Orders'} (${visibleCount})`;
        }
        if (filterBadge) {
            filterBadge.textContent = status === 'all' ? 'All Statuses' : (statusLabels[status] || status);
        }

        // Update URL query parameter without full reload
        try {
            const url = new URL(window.location);
            if (status === 'all') {
                url.searchParams.delete('status');
            } else {
                url.searchParams.set('status', status);
            }
            window.history.replaceState({}, '', url);
        } catch(e) {}
    }

    // Update filter badge counts
    function updateFilterCounts() {
        const rows = document.querySelectorAll('.order-row');
        const counts = { all: 0, placed: 0, shipped: 0, delivered: 0, pending: 0, canceled: 0 };
        
        rows.forEach(row => {
            const s = row.getAttribute('data-status');
            counts.all++;
            if (counts[s] !== undefined) counts[s]++;
        });
        
        Object.keys(counts).forEach(key => {
            const el = document.getElementById('count-' + key);
            if (el) el.textContent = counts[key];
        });
    }

    // Toast notification
    function showStatusToast(message) {
        let toast = document.createElement('div');
        toast.className = 'position-fixed bottom-0 end-0 m-4 p-3 bg-dark text-white rounded-3 shadow-lg';
        toast.style.zIndex = '9999';
        toast.style.transition = 'all 0.3s ease';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        toast.innerHTML = '<div class="d-flex align-items-center gap-2"><span>✅</span><span class="fw-medium small">' + message + '</span></div>';
        document.body.appendChild(toast);
        
        requestAnimationFrame(() => {
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
        });
        
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(10px)';
            setTimeout(() => toast.remove(), 300);
        }, 2500);
    }

    // Initialize counts and apply URL filter on page load
    document.addEventListener('DOMContentLoaded', () => {
        updateFilterCounts();

        // Check URL query parameter for status filter
        const urlParams = new URLSearchParams(window.location.search);
        const statusParam = urlParams.get('status');
        if (statusParam && ['placed', 'shipped', 'delivered', 'pending', 'canceled'].includes(statusParam)) {
            filterOrdersByStatus(statusParam);
        }
    });
</script>