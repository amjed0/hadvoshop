<section class="admin-users-section py-4 bg-light min-vh-100">
    <div class="container-fluid px-lg-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Registered Users</h2>
                <p class="text-muted small mb-0">View customer database and their individual order histories.</p>
            </div>
            <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Back to Dashboard</a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 py-3 px-4">
                <h5 class="fw-bold mb-0">Customer Directory ({{users.length}})</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase letter-spacing-1">
                        <tr>
                            <th class="ps-4 py-3">Customer</th>
                            <th class="py-3">Email Address</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#if users.length}}
                            {{#each users}}
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-7 shadow-2xs" style="width: 38px; height: 38px;">
                                            {{this.Name.[0]}}
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">{{this.Name}}</div>
                                            <span class="badge bg-light text-muted border rounded-pill px-2 py-0 fs-8">Customer</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="text-secondary small">{{this.Email}}</span>
                                </td>

                                <td class="text-end pe-4">
                                    <a href="/admin/view-user-orders/{{this._id}}"
                                        class="btn btn-sm btn-dark rounded-pill px-3 py-1">
                                        View Orders
                                    </a>
                                </td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-muted mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                        </svg>
                                    </div>
                                    <h5 class="fw-bold mb-1">No Registered Users Yet</h5>
                                    <p class="text-muted small mb-0">Users who register on the storefront will appear here.</p>
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>