<section>
    <div class="container">

        <div class="row mt-4">
            <h3>All Users</h3>
        </div>

        <div class="table-responsive mt-4">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each users}}
                    <tr>
                        <td>
                            {{this.Name}}
                        </td>

                        <td>{{this.Email}}</td>

                        <td>
                            <a href="/admin/view-user-orders/{{this._id}}"
                                class="btn {{#if this.hasNewOrders}}btn-success{{else}}btn-primary{{/if}} btn-sm">
                                View Orders
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

    </div>
</section>