<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">Edit Product</h3>
                        <p class="text-muted small mb-0">Update product specifications and pricing</p>
                    </div>
                    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Back</a>
                </div>

                <div id="catFeedback" class="alert alert-success rounded-3 mb-4 d-none"></div>

                <form action="/admin/edit-product/{{product._id}}" method="POST" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Product Name *</label>
                        <input type="text" name="name" class="form-control rounded-3" value="{{product.name}}" required>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-medium small text-muted mb-0">Category *</label>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-2 py-0 fs-7" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                                ➕ New Category
                            </button>
                        </div>
                        <select name="category" id="categorySelect" class="form-select rounded-3" required>
                            {{#each categories}}
                            <option value="{{this.name}}" {{#if (eq this.name ../product.category)}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <!-- Price & Offer Price (Two Spaces) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium small text-muted">Regular Price (₹) *</label>
                            <input type="number" step="0.01" name="price" class="form-control rounded-3" value="{{product.price}}" required>
                            <div class="form-text small">Original price</div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label fw-medium small text-muted mb-0">Offer Price (₹)</label>
                                <span class="badge bg-light text-muted border px-2 py-0 fs-8">Optional</span>
                            </div>
                            <input type="number" step="0.01" name="offerPrice" class="form-control rounded-3 mt-1" value="{{product.offerPrice}}" placeholder="Leave blank if no offer">
                            <div class="form-text small">Discounted sale price</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Description *</label>
                        <textarea name="description" class="form-control rounded-3" rows="3" required>{{product.description}}</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Main Product Image</label>
                        <div class="mb-2">
                            <img src="{{#if product.image}}{{product.image}}{{else}}/product-images/{{product._id}}.jpg{{/if}}" id="imgView" class="img-thumbnail rounded-3 shadow-2xs border" style="max-height: 120px; object-fit: contain;" onerror="this.onerror=null;this.src='/images/hadvo_banner.png';">
                        </div>
                        <input type="file" name="image" class="form-control rounded-3" accept="image/*" onchange="viewImage(event)">
                        <div class="form-text small">Upload a new file only if you want to replace the main image.</div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-medium small text-muted mb-0">Additional Product Photos</label>
                            <span class="badge bg-light text-muted border px-2 py-0 fs-8">Optional · Multiple</span>
                        </div>
                        {{#if product.images.length}}
                        <div class="mb-2">
                            <span class="small text-muted d-block mb-1">Current Extra Photos:</span>
                            <div class="d-flex flex-wrap gap-2">
                                {{#each product.images}}
                                <img src="{{this}}" class="img-thumbnail rounded-3 border" style="width: 60px; height: 60px; object-fit: contain; background: #f8f9fa;">
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}
                        <input type="file" name="images" class="form-control rounded-3" accept="image/*" multiple onchange="viewExtraImages(event)">
                        <div class="form-text small">Add more photos to product gallery (Hold Ctrl/Cmd to select multiple).</div>
                        <div id="extraImagesPreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 rounded-3 fw-semibold shadow-sm">Save Changes</button>
                </form>
            </div>

        </div>
    </div>
</section>

<!-- Add Category Modal with Image Upload -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="addCategoryModalLabel">Add New Category</h5>
                    <p class="text-muted small mb-0">Instantly creates a new store category.</p>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="newCatForm" onsubmit="submitNewCategory(event)" enctype="multipart/form-data">
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Category Name *</label>
                        <input type="text" id="newCatName" name="name" class="form-control rounded-3" placeholder="e.g. Footwear, Watches, Jewelry" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Description (Optional)</label>
                        <textarea id="newCatDesc" name="description" class="form-control rounded-3" rows="2" placeholder="Brief description..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Category Image (Optional)</label>
                        <input type="file" id="newCatImg" name="categoryImage" class="form-control rounded-3" accept="image/*" onchange="previewCategoryImg(event)">
                        <div class="mt-2 text-center">
                            <img id="catModalImgPreview" src="#" alt="Preview" class="img-thumbnail rounded-3 d-none" style="max-height: 100px; object-fit: cover;">
                        </div>
                    </div>
                    <div id="modalError" class="alert alert-danger py-2 small d-none"></div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveCatBtn" class="btn btn-dark rounded-pill px-4">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function viewImage(event){
        if (event.target.files && event.target.files[0]) {
            document.getElementById('imgView').src = URL.createObjectURL(event.target.files[0]);
        }
    }

    function viewExtraImages(event) {
        const container = document.getElementById('extraImagesPreviewContainer');
        container.innerHTML = '';
        if (event.target.files && event.target.files.length > 0) {
            for (let i = 0; i < event.target.files.length; i++) {
                const file = event.target.files[i];
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.className = 'img-thumbnail rounded-3 border shadow-2xs';
                img.style.width = '60px';
                img.style.height = '60px';
                img.style.objectFit = 'contain';
                img.style.background = '#f8f9fa';
                container.appendChild(img);
            }
        }
    }

    function previewCategoryImg(event) {
        const preview = document.getElementById('catModalImgPreview');
        if (event.target.files && event.target.files[0]) {
            preview.src = URL.createObjectURL(event.target.files[0]);
            preview.classList.remove('d-none');
        }
    }

    async function submitNewCategory(event) {
        event.preventDefault();
        const form = document.getElementById('newCatForm');
        const formData = new FormData(form);
        const errorEl = document.getElementById('modalError');
        const saveBtn = document.getElementById('saveCatBtn');

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        errorEl.classList.add('d-none');

        try {
            const res = await fetch('/admin/add-category', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (res.ok && data.category) {
                const select = document.getElementById('categorySelect');
                
                let exists = false;
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].value.toLowerCase() === data.category.name.toLowerCase()) {
                        select.selectedIndex = i;
                        exists = true;
                        break;
                    }
                }

                if (!exists) {
                    const opt = document.createElement('option');
                    opt.value = data.category.name;
                    opt.textContent = data.category.name;
                    opt.selected = true;
                    select.appendChild(opt);
                }

                const modalEl = document.getElementById('addCategoryModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalInstance.hide();

                form.reset();
                document.getElementById('catModalImgPreview').classList.add('d-none');

                const feedback = document.getElementById('catFeedback');
                feedback.textContent = `✅ Category "${data.category.name}" added and selected!`;
                feedback.classList.remove('d-none');
                setTimeout(() => feedback.classList.add('d-none'), 5000);
            } else {
                errorEl.textContent = data.error || 'Failed to add category.';
                errorEl.classList.remove('d-none');
            }
        } catch (err) {
            console.error(err);
            errorEl.textContent = 'Server error while saving category.';
            errorEl.classList.remove('d-none');
        } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Category';
        }
    }
</script>
