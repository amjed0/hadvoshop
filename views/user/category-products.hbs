<section class="category-page-header py-5 bg-light border-bottom">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Categories</a></li>
        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">{{categoryName}}</li>
      </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
      <div>
        <span class="badge bg-dark-subtle text-dark mb-2 px-3 py-1 rounded-pill fw-medium text-uppercase letter-spacing-1">
          {{#if category.tag}}{{category.tag}}{{else}}COLLECTION{{/if}}
        </span>
        <h1 class="display-5 fw-bold mb-2">{{categoryName}}</h1>
        <p class="text-muted mb-0 max-w-600">
          {{#if category.description}}{{category.description}}{{else}}Discover our carefully curated {{categoryName}} collection crafted for modern living.{{/if}}
        </p>
      </div>

      <div class="text-md-end">
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-sm">
          {{products.length}} {{#if (eq products.length 1)}}Product{{else}}Products{{/if}}
        </span>
      </div>
    </div>

    <!-- Category Switcher Tabs -->
    {{#if allCategories}}
    <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
      <span class="small text-muted align-self-center me-2">Browse categories:</span>
      {{#each allCategories}}
      <a href="/category/{{this.name}}" class="btn btn-sm rounded-pill px-3 py-1 {{#if (eq this.name ../categoryName)}}btn-dark{{else}}btn-outline-secondary bg-white{{/if}}">
        {{this.name}}
      </a>
      {{/each}}
    </div>
    {{/if}}
  </div>
</section>

<section class="category-products-grid py-5">
  <div class="container">

    {{#if products.length}}
      <div class="row g-4">
        {{#each products}}
          <div class="col-6 col-md-4 col-lg-3">
            <div class="product-card">
              <div class="product-img-wrap">
                <img src="{{#if this.image}}{{this.image}}{{else}}/product-images/{{this._id}}.jpg{{/if}}" alt="{{this.name}}" onerror="this.onerror=null;this.src='/images/hadvo_banner.png';">
              </div>
              <div class="product-info">
                <span class="product-tag">{{this.category}}</span>
                <h4 class="product-title">{{this.name}}</h4>
                <p class="product-desc">{{this.description}}</p>
                <div class="product-meta">
                  {{#if this.offerPrice}}
                    <div class="d-flex align-items-baseline gap-2">
                      <span class="product-price">₹{{this.offerPrice}}</span>
                      <del class="text-muted small">₹{{this.price}}</del>
                    </div>
                  {{else}}
                    <span class="product-price">₹{{this.price}}</span>
                  {{/if}}
                  <button onclick="addToCart('{{this._id}}')" class="add-to-cart-btn" id="add-{{this._id}}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add
                  </button>
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <!-- Empty State -->
      <div class="text-center py-5 my-5">
        <div class="mb-3 text-muted">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <h4 class="fw-bold mb-2">No Products in {{categoryName}} Yet</h4>
        <p class="text-muted mb-4">We are currently curating items for this category. Check back soon!</p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/" class="btn btn-outline-dark rounded-pill px-4">Browse All Shop</a>
        </div>
      </div>
    {{/if}}

  </div>
</section>
