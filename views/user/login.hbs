<div class="container py-5 my-3">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-muted small">Sign in to your Hadvo account</p>
                </div>

                {{#if loginErr}}
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-4 rounded-3 border-danger-subtle p-3" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-triangle-fill text-danger flex-shrink-0 mt-1" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                    </svg>
                    <div>
                        <div class="fw-semibold text-danger">{{loginErr}}</div>
                        {{#if isUserNotFound}}
                        <div class="mt-2 pt-2 border-top border-danger-subtle small text-dark">
                            Don't have an account yet? 
                            <a href="/signup" class="alert-link fw-bold text-danger text-decoration-underline ms-1">Create an account / Sign Up &rarr;</a>
                        </div>
                        {{/if}}
                    </div>
                </div>
                {{/if}}

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Email address</label>
                        <input type="email" class="form-control form-control-lg rounded-3 fs-6" name="Email" placeholder="Enter your email" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium small text-muted">Password</label>
                        <div class="input-group">
                            <input type="password" id="userLoginPassword" class="form-control form-control-lg rounded-start-3 fs-6" name="Password" placeholder="Enter your password" required>
                            <button class="btn btn-outline-secondary rounded-end-3 px-3 d-flex align-items-center" type="button" onclick="togglePasswordVisibility('userLoginPassword', this)" title="Show/Hide password">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <a href="/signup" class="text-decoration-none small text-primary fw-medium">Create new account</a>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold shadow-sm">Login</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';

    btn.innerHTML = isPassword 
        ? `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
           </svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
             <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
           </svg>`;
}
</script>