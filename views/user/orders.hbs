<section>
  <div class="container">
    <div class="row">
      <h2 class="text-center mt-4">🧾 My Orders</h2>

      <div id="orders-container" class="container mt-4">
        {{#if orders.length}}
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Date</th>
              <th>Address</th>
              <th>Pincode</th>
              <th>Mobile</th>
              <th>Amount</th>
              <th>Payment</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each orders}}
            <tr>
              <td>{{this.date}}</td>
              <td>{{this.deliveryDetails.address}}</td>
              <td>{{this.deliveryDetails.pincode}}</td>
              <td>{{this.deliveryDetails.mobile}}</td>
              <td>₹{{this.totalAmount}}</td>
              <td>{{this.paymentMethod}}</td>
              <td>{{this.status}}</td>
              <td>
                <a href="/view-order-products/{{this._id}}" class="btn btn-primary">View Products</a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <div class="alert alert-warning text-center">📭 No orders placed yet.</div>
        {{/if}}
      </div>
    </div>
  </div>
</section>