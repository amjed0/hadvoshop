<section class="orders-section">
  <div class="container">

    <!-- Header -->
    <div class="orders-page-header">
      <span class="orders-page-tag">ACCOUNT</span>
      <h1 class="orders-page-title">My Orders</h1>
      <p class="orders-page-desc">Track and manage all your past and current orders.</p>
    </div>

    {{#if orders.length}}
    <div class="orders-list">
      {{#each orders}}
      <div class="order-card">
        <!-- Order Top Bar -->
        <div class="order-card-header">
          <div class="order-meta-group">
            <div class="order-meta-item">
              <span class="order-meta-label">Order Date</span>
              <span class="order-meta-value">{{this.date}}</span>
            </div>
            <div class="order-meta-item">
              <span class="order-meta-label">Total Amount</span>
              <span class="order-meta-value fw-bold">₹{{this.totalAmount}}</span>
            </div>
            <div class="order-meta-item">
              <span class="order-meta-label">Payment</span>
              <span class="order-meta-value">{{this.paymentMethod}}</span>
            </div>
          </div>
          <div class="order-status-badge status-{{this.status}}">
            {{#if (eq this.status 'placed')}}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Placed
            {{else if (eq this.status 'shipped')}}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
              Shipped
            {{else if (eq this.status 'delivered')}}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Delivered
            {{else if (eq this.status 'cancelled')}}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              Cancelled
            {{else}}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
              {{this.status}}
            {{/if}}
          </div>
        </div>

        <!-- Delivery Details -->
        <div class="order-card-body">
          <div class="order-delivery-info">
            <span class="order-delivery-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Delivery Address
            </span>
            <span class="order-delivery-text">{{this.deliveryDetails.address}}, {{this.deliveryDetails.pincode}}</span>
            <span class="order-delivery-mobile">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {{this.deliveryDetails.mobile}}
            </span>
          </div>
          <a href="/view-order-products/{{this._id}}" class="order-view-btn">
            View Items
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
      {{/each}}
    </div>

    {{else}}
    <!-- Empty State -->
    <div class="orders-empty-state">
      <div class="orders-empty-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
      </div>
      <h3>No orders yet</h3>
      <p>You haven't placed any orders. Start shopping to see your orders here.</p>
      <a href="/" class="btn-hadvo-primary">Explore Shop</a>
    </div>
    {{/if}}

  </div>
</section>

<style>
  .orders-section {
    padding: 4rem 0 8rem;
    background: var(--bg-cream);
    min-height: 60vh;
  }

  .orders-page-header {
    margin-bottom: 3rem;
  }
  .orders-page-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey-400);
  }
  .orders-page-title {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.8px;
    margin: 0.3rem 0 0.4rem;
  }
  .orders-page-desc {
    font-size: 0.92rem;
    color: var(--grey-600);
    margin: 0;
  }

  /* Orders list */
  .orders-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 860px;
  }

  /* Order card */
  .order-card {
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    overflow: hidden;
    transition: var(--transition);
  }
  .order-card:hover {
    border-color: var(--grey-400);
    box-shadow: var(--shadow-sm);
  }

  /* Card header */
  .order-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--grey-100);
    gap: 1rem;
    flex-wrap: wrap;
  }
  .order-meta-group {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .order-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .order-meta-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--grey-400);
  }
  .order-meta-value {
    font-size: 0.88rem;
    color: var(--black);
    font-weight: 500;
  }

  /* Status badge */
  .order-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    flex-shrink: 0;
  }
  .order-status-badge.status-placed    { background: #e8f4fd; color: #1a6ea8; }
  .order-status-badge.status-shipped   { background: #fff3cd; color: #856404; }
  .order-status-badge.status-delivered { background: #d1e7dd; color: #0a6636; }
  .order-status-badge.status-cancelled { background: #f8d7da; color: #842029; }
  .order-status-badge.status-pending   { background: #f0f0f0; color: #555; }

  /* Card body */
  .order-card-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .order-delivery-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .order-delivery-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--grey-400);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .order-delivery-text {
    font-size: 0.88rem;
    color: var(--black);
    font-weight: 500;
  }
  .order-delivery-mobile {
    font-size: 0.82rem;
    color: var(--grey-600);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* View items button */
  .order-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 50px;
    padding: 0.55rem 1.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: var(--transition);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .order-view-btn:hover {
    background: #333;
    color: var(--white);
    transform: translateY(-1px);
  }

  /* Empty state */
  .orders-empty-state {
    text-align: center;
    padding: 5rem 1rem;
  }
  .orders-empty-icon {
    color: var(--grey-200);
    margin-bottom: 1.5rem;
  }
  .orders-empty-state h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .orders-empty-state p {
    font-size: 0.92rem;
    color: var(--grey-600);
    max-width: 380px;
    margin: 0 auto 2rem;
  }

  @media (max-width: 576px) {
    .order-card-header { flex-direction: column; align-items: flex-start; }
    .order-meta-group  { gap: 1rem; }
    .order-card-body   { flex-direction: column; align-items: flex-start; }
    .order-view-btn    { width: 100%; justify-content: center; }
  }
</style>