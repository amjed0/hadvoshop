<section class="checkout-section">
  <div class="container">
    <div class="checkout-header">
      <span class="checkout-tag">SECURE CHECKOUT</span>
      <h1 class="checkout-title">Complete Your Order</h1>
      <p class="checkout-desc">Enter your delivery address and choose a payment method to finalize your order.</p>
    </div>

    <div class="row gy-5">
      <!-- Form Column -->
      <div class="col-lg-7">
        <div class="checkout-card">
          <h2 class="card-section-title">01 / Shipping Details</h2>
          <form action="/place-order" id="checkout-form" method="POST">
            <div class="row g-4">
              <div class="col-12">
                <label for="address" class="hadvo-form-label">Full Address</label>
                <textarea class="hadvo-form-control" name="address" id="address" rows="3" placeholder="Apartment, suite, street address" required></textarea>
              </div>
              <div class="col-md-6">
                <label for="pincode" class="hadvo-form-label">Postal Pincode</label>
                <input type="tel" inputmode="numeric" class="hadvo-form-control" name="pincode" id="pincode" maxlength="6" placeholder="6-digit pincode" required oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,6)">
                <p id="pincode-warning" class="hadvo-warning-text" style="display:none;">Pincode must be exactly 6 digits</p>
              </div>
              <div class="col-md-6">
                <label for="mobile" class="hadvo-form-label">Contact Number</label>
                <input type="tel" inputmode="numeric" class="hadvo-form-control" name="mobile" id="mobile" maxlength="10" placeholder="10-digit mobile number" required oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)">
                <p id="mobile-warning" class="hadvo-warning-text" style="display:none;">Mobile number must be exactly 10 digits</p>
                <input type="hidden" name="userId" value="{{user._id}}">
              </div>
            </div>

            <h2 class="card-section-title mt-5">02 / Payment Method</h2>
            <div class="payment-methods-group">
              <label class="payment-method-card">
                <input type="radio" name="payment-method" value="COD" checked>
                <span class="payment-card-content">
                  <span class="payment-title">Cash on Delivery (COD)</span>
                  <span class="payment-subtitle">Pay with cash upon delivery.</span>
                </span>
              </label>

              <label class="payment-method-card mt-3">
                <input type="radio" name="payment-method" value="ONLINE">
                <span class="payment-card-content">
                  <span class="payment-title">Online Payment (Razorpay)</span>
                  <span class="payment-subtitle">Pay securely with Cards, Netbanking, UPI, or Wallets.</span>
                </span>
              </label>
            </div>

            <button class="btn-hadvo-checkout mt-5" type="submit">Place Order</button>
          </form>
        </div>
      </div>

      <!-- Summary Column -->
      <div class="col-lg-5">
        <div class="checkout-summary-card">
          <h2 class="summary-card-title">Order Summary</h2>
          <div class="summary-line-item">
            <span>Subtotal</span>
            <span>₹{{total}}</span>
          </div>
          <div class="summary-line-item">
            <span>Shipping</span>
            <span class="text-free">FREE</span>
          </div>
          <hr class="summary-divider">
          <div class="summary-total-item">
            <span>Total Amount</span>
            <span>₹{{total}}</span>
          </div>
          <div class="summary-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            SSL Secure Checkout
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  $("#checkout-form").submit(function (e) {
    e.preventDefault(); // Stop normal form submission

    var pincode = $("#pincode").val();
    if (!/^\d{6}$/.test(pincode)) {
      $("#pincode-warning").show();
      return;
    }
    $("#pincode-warning").hide();

    var mobile = $("#mobile").val();
    if (!/^\d{10}$/.test(mobile)) {
      $("#mobile-warning").show();
      return;
    }
    $("#mobile-warning").hide();

    // Disable button to prevent double clicks
    const submitBtn = $(this).find('button[type="submit"]');
    submitBtn.prop('disabled', true).text('Processing...');

    $.ajax({
      url: "/place-order",
      method: "post",
      data: $("#checkout-form").serialize(),
      success: function (response) {
        if (response.codSuccess) {
          // COD order placed
          window.location.href = "/order-success";
        } else if (response.error) {
          alert("Error: " + response.message);
          submitBtn.prop('disabled', false).text('Place Order');
        } else {
          // Razorpay payment: open popup with order details
          openRazorpayPayment(response, submitBtn);
        }
      },
      error: function () {
        alert("Order placement failed. Please try again.");
        submitBtn.prop('disabled', false).text('Place Order');
      }
    });
  });

  function openRazorpayPayment(order, submitBtn) {
    var options = {
      "key": order.key, // Dynamic key passed from backend
      "amount": order.amount, // Amount in paise
      "currency": "INR",
      "name": "hadvo",
      "description": "Refined Essentials Purchase",
      "order_id": order.id,     // Provided by backend
      "handler": function (response) {
        verifyPayment(response, order, submitBtn);
      },
      "modal": {
        "ondismiss": function() {
          submitBtn.prop('disabled', false).text('Place Order');
        }
      },
      "prefill": {
        "name": "{{user.Name}}",
        "email": "{{user.Email}}",
        "contact": $("#mobile").val()
      },
      "theme": {
        "color": "#111111"
      }
    };
    var rzp = new Razorpay(options);
    rzp.open();
  }

  function verifyPayment(payment, order, submitBtn) {
    $.ajax({
      url: "/verify-payment",
      method: "post",
      data: {
        payment: payment,
        order: order
      },
      success: function (response) {
        if (response.status) {
          window.location.href = "/order-success";
        } else {
          alert("Payment verification failed. Please contact support.");
          submitBtn.prop('disabled', false).text('Place Order');
        }
      },
      error: function() {
        alert("Verification request failed. Please check connection.");
        submitBtn.prop('disabled', false).text('Place Order');
      }
    });
  }
</script>

<style>
