  }

  .summary-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--grey-600);
    background: var(--bg-light);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
  }
</style>