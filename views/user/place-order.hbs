  .card-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 2rem;
    color: var(--black);
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 1px;
    border-bottom: 1px solid var(--grey-100);
    padding-bottom: 0.8rem;
  }

  .hadvo-form-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--grey-600);
    margin-bottom: 0.5rem;
    display: block;
  }

  .hadvo-form-control {
    width: 100%;
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-family: var(--font);
