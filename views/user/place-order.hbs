    background: var(--bg-light);
    color: var(--black);
    transition: var(--transition);
  }

  .hadvo-form-control:focus {
    border-color: var(--black);
    background: var(--white);
  }

  .hadvo-warning-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #dc3545;
    margin: 0.4rem 0 0;
  }

  /* Custom Payment Cards */
  .payment-methods-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payment-method-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 1.25rem;
    border: 1px solid var(--grey-200);
    border-radius: var(--radius);
    background: var(--white);
    cursor: pointer;
    transition: var(--transition);
  }

  .payment-method-card:hover {
    border-color: var(--grey-400);
  }

  .payment-method-card input[type="radio"] {
    appearance: none;
    background-color: #fff;
    margin: 3px 0 0;
    font: inherit;
    color: var(--black);
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--grey-400);
    border-radius: 50%;
    display: grid;
    place-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .payment-method-card input[type="radio"]::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transform: scale(0);
    transition: var(--transition);
    box-shadow: inset 1em 1em var(--black);
  }

  .payment-method-card input[type="radio"]:checked {
    border-color: var(--black);
  }

  .payment-method-card input[type="radio"]:checked::before {
    transform: scale(1);
  }

  .payment-card-content {
    display: flex;
    flex-direction: column;
  }

  .payment-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--black);
  }

  .payment-subtitle {
    font-size: 0.78rem;
    color: var(--grey-600);
    margin-top: 0.15rem;
  }

  .btn-hadvo-checkout {
    background: var(--black);
    color: var(--white);
    border: none;
    border-radius: 50px;
    padding: 0.9rem 2.2rem;
    font-size: 0.88rem;
    font-weight: 700;
    width: 100%;
    cursor: pointer;
    text-transform: uppercase;
